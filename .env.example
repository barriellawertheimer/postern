# Postern — example env file. Copy to `.env` and fill in.
# Generate fresh keys with:
#   node -e "console.log('ENC_KEY='+require('node:crypto').randomBytes(32).toString('hex'))"
#   node -e "console.log('LOOKUP_KEY='+require('node:crypto').randomBytes(32).toString('hex'))"

# --- runtime
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# --- database
DATABASE_PATH=./data/postern.db

# --- encryption keys (32 bytes each, hex or base64). Independent values.
# Alternative: KEY_FILE=/etc/postern/keys.json (mode 0600, JSON {"enc":"...","lookup":"..."})
ENC_KEY=
LOOKUP_KEY=
# KEY_FILE=

# --- SimpleLogin (paid plan required: free SL is capped at 10 aliases)
SL_BASE_URL=https://app.simplelogin.io
SL_API_KEY=
OWNER_DOMAIN=ownerdomain.com

# --- Proton SMTP (Proton Mail Plus or above; create an SMTP token in Proton settings)
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=you@protonmail.com
SMTP_PASS=
# Optional: send To: a different Proton address than the auth user. Defaults to SMTP_USER.
# OWNER_EMAIL=

# --- Cloudflare Turnstile (required in production)
TURNSTILE_SECRET=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# --- Caps & rate limits
PROTON_DAILY_CAP=1000
PROTON_HOURLY_CAP=300
CIRCUIT_BREAKER_PCT=0.95
RATE_LIMIT_PER_IP_PER_MIN=5
RATE_LIMIT_PER_IP_PER_HOUR=20

# --- Alias generation (e.g. john.doe.12345)
ALIAS_SUFFIX_KIND=digits
ALIAS_SUFFIX_LENGTH=5
ALIAS_SEPARATOR=.

# --- CORS allowlist (comma-separated). Empty = same-origin only.
ALLOWED_ORIGINS=https://www.ownerdomain.com,https://ownerdomain.com

# --- Admin UI (mounted at /admin). Disabled by default.
# Generate hash with: npm run hash:admin
# Generate session secret with:
#   node -e "console.log('ADMIN_SESSION_SECRET='+require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_ENABLED=false
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12
# ADMIN_COOKIE_SECURE=true  # defaults to NODE_ENV==production
